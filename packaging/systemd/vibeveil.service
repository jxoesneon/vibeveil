[Unit]
Description=VibeVeil Music-Driven Dynamic Wallpaper & Theming Daemon
Documentation=https://github.com/jxoesneon/vibeveil
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/vibeveil daemon
Restart=always
RestartSec=3s
Slice=app.slice

# Hardening & Isolation
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.cache/vibeveil %h/.config/vibeveil %h/.config/hypr %h/.config/noctalia
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=graphical-session.target
