# Maintainer: Jose Eduardo Rojas Jimenez <joseeduardox@gmail.com>
pkgname=vibeveil
pkgver=0.1.0
pkgrel=1
pkgdesc="Universal music-driven dynamic wallpaper & semantic desktop theming engine"
arch=('x86_64' 'aarch64')
url="https://github.com/jxoesneon/vibeveil"
license=('MIT' 'Apache-2.0')
depends=('dbus' 'glibc' 'gcc-libs')
makedepends=('cargo')
optdepends=(
    'hyprland: Wayland compositor support'
    'noctalia-shell: Material You dynamic bar and widget theming'
    'mpvpaper: Hardware-accelerated video wallpaper daemon'
    'swww: Efficient Wayland animated wallpaper daemon'
    'ffmpeg: Automatic thumbnail extraction for video wallpapers'
    'rofi: Interactive wallpaper switcher menu'
    'wofi: Interactive Wayland wallpaper switcher menu'
    'hyprlock: Dynamic lockscreen color synchronization'
    'libnotify: Desktop notification verification and diagnostics'
)
provides=('vibeveil')
conflicts=('vibeveil-bin' 'vibeveil-git')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --all-targets

    # Generate shell completions
    ./target/release/vibeveil completions bash > vibeveil.bash
    ./target/release/vibeveil completions zsh > _vibeveil
    ./target/release/vibeveil completions fish > vibeveil.fish
}

check() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --frozen
}

package() {
    cd "$pkgname-$pkgver"

    # Install binary
    install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"

    # Install systemd user service
    install -Dm644 "packaging/systemd/vibeveil.service" "$pkgdir/usr/lib/systemd/user/vibeveil.service"

    # Install shell completions
    install -Dm644 "vibeveil.bash" "$pkgdir/usr/share/bash-completion/completions/vibeveil"
    install -Dm644 "_vibeveil" "$pkgdir/usr/share/zsh/site-functions/_vibeveil"
    install -Dm644 "vibeveil.fish" "$pkgdir/usr/share/fish/vendor_completions.d/vibeveil.fish"

    # Install documentation
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 docs/PRD.md "$pkgdir/usr/share/doc/$pkgname/PRD.md"
    install -Dm644 docs/RUNBOOK.md "$pkgdir/usr/share/doc/$pkgname/RUNBOOK.md"
}
