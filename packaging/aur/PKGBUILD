# Maintainer: Jose Eduardo Rojas Jimenez <joseeduardox@gmail.com>
pkgname=vibeveil
pkgver=0.2.0
pkgrel=1
pkgdesc="Universal music-driven dynamic wallpaper and semantic desktop theming engine in Rust"
arch=('x86_64' 'aarch64')
url="https://github.com/jxoesneon/vibeveil"
license=('MIT' 'Apache-2.0')
depends=('gcc-libs' 'ffmpeg')
optdepends=(
    'hyprland: dynamic wallpaper compositor and border coloring'
    'hyprlock: dynamic lockscreen color synchronization'
    'mpvpaper: hardware-accelerated live video wallpaper playback'
    'swww: animated wallpaper daemon'
    'rofi-wayland: modern interactive control center switcher'
    'wofi: alternative Wayland application launcher and switcher'
    'libnotify: desktop notifications'
)
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --all-targets
}

check() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --frozen --all-targets
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 "target/release/vibeveil" "$pkgdir/usr/bin/vibeveil"
    install -Dm644 "packaging/systemd/vibeveil.service" "$pkgdir/usr/lib/systemd/user/vibeveil.service"
    sed -i 's|%h/.local/bin/vibeveil|/usr/bin/vibeveil|g' "$pkgdir/usr/lib/systemd/user/vibeveil.service"
    install -Dm644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "LICENSE-MIT" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
    install -Dm644 "LICENSE-APACHE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"

    # Shell completions
    target/release/vibeveil completions bash | install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/vibeveil"
    target/release/vibeveil completions zsh | install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_vibeveil"
    target/release/vibeveil completions fish | install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/vibeveil.fish"
}
